class Cecilia < Formula
  desc "Keyboard-first editor and player for guitar tab, standard notation and Gregorian chant"
  homepage "https://github.com/kjmcnamara1/cecilia"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/kjmcnamara1/cecilia/releases/download/v@VERSION@/cecilia-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/kjmcnamara1/cecilia/releases/download/v@VERSION@/cecilia-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_DARWIN_X86_64@"
    end
  end

  on_linux do
    depends_on arch: :x86_64
    depends_on "alsa-lib"

    url "https://github.com/kjmcnamara1/cecilia/releases/download/v@VERSION@/cecilia-v@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
    sha256 "@SHA_LINUX_X86_64@"
  end

  def install
    bin.install "cecilia"
    doc.install "README.md", "CHANGELOG.md"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/cecilia --version")
  end
end
