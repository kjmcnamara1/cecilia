<?xml version="1.0" encoding="UTF-8"?>
<!-- File types cecilia opens that shared-mime-info does not know. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-cecilia">
    <comment>cecilia score</comment>
    <glob pattern="*.cc"/>
  </mime-type>
  <mime-type type="application/x-guitar-pro">
    <comment>Guitar Pro tablature</comment>
    <glob pattern="*.gp"/>
    <glob pattern="*.gpx"/>
    <glob pattern="*.gp5"/>
    <glob pattern="*.gp4"/>
    <glob pattern="*.gp3"/>
  </mime-type>
  <mime-type type="text/x-gabc">
    <sub-class-of type="text/plain"/>
    <comment>Gregorio chant (GABC)</comment>
    <glob pattern="*.gabc"/>
  </mime-type>
</mime-info>
